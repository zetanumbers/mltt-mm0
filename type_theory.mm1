-- --| Dependent pair
-- term pair (a b: wff): wff;

-- axiom subst_pair {x: wff} (a A: wff) (b c B: wff x):
--     $ eq_intro ((pair b c)[a / x]) (pair (b[a / x]) (c[a / x])) (Sigma x A B) $;

-- --| Sigma formation
-- axiom sigma_form {x: wff} (A: wff) (B: wff x) (l: lvl):
--     $ (A: U l /\ (x: A => B: U l)) <=> Sigma x A B: U l $;

-- --| Sigma introduction
-- axiom sigma_intro {x: wff} (a A b: wff) (B: wff x) (l: lvl):
--     $ (x: A => B: U l) => a: A => b: B[a / x] => (pair a b) : Sigma x A B $;

-- term ind_Sigma {x y z: wff} (A: wff) (B: wff x) (g: wff x y) (C: wff z) (p: wff): wff;

-- axiom ind_Sigma_subst {x y z w: wff} (A: wff) (B: wff x) (g: wff x y) (C: wff z) (p d: wff):
--     $ (ind_Sigma x y z A B g C p)[d / w] = (ind_Sigma x y z (A[d / w]) (B[d / w]) (g[d / w]) (C[d / w]) (p[d / w])): C[p / z] $;

-- --| Sigma elimination
-- axiom sigma_elim {x y z: wff} (A p: wff) (B: wff x) (g: wff x y) (C: wff z) (l: lvl):
--     $ (z: Sigma x A B => C: U l) =>
--       (x: A => y: B => g: C[(pair x y) / z]) =>
--       p: Sigma x A B =>
--       (ind_Sigma x y z A B g C p) : C[p / z] $;

-- --| Sigma computation
-- axiom sigma_comp {x y z: wff} (a A b: wff) (B: wff x) (g: wff x y) (C: wff z) (l: lvl):
--     $ (z: Sigma x A B => C: U l) =>
--       (x: A => y: B => g: C[(pair x y) / z]) =>
--       p: Sigma x A B =>
--       (ind_Sigma x y z A B g C (pair a b)) = g[a / x][b / y] : C[(pair a b) / z] $;
