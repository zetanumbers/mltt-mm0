delimiter $ ( $ $ , ) : $;

sort term;
provable strict sort jdmt;
strict sort ctx;

strict sort term_or_eq;
term term_not_eq: term > term_or_eq;
coercion term_not_eq: term > term_or_eq;
term eq_not_term: term > term > term_or_eq;
infixl eq_not_term: $=$ prec 25;

strict sort typed_expr;
term typed: term_or_eq > term > typed_expr;
infixl typed: $:$ prec 20;

strict sort consequent;
term typed_consequent: typed_expr > consequent;
coercion typed_consequent: typed_expr > consequent;

term sequent: ctx > consequent > jdmt;
infixr sequent: $|-$ prec 10;

term ctx_consequent: consequent;
def is_ctx (G: ctx): jdmt = $ G |- ctx_consequent $;
prefix is_ctx: $ctx$ prec 10;

term zctx: ctx;
axiom ctx_emp: $ is_ctx zctx $;

term comma: ctx > ctx > ctx;
infixl comma: $,$ prec 15;

term ty_ctx: typed_expr > ctx;
coercion ty_ctx: typed_expr > ctx;

sort lvl;
term lz: lvl;
term ls: lvl > lvl;

term U: lvl > term;

term sbst {x: term} (a: term) (b: term x): term;
term rwt: term > term > jdmt;

axiom rwt_refl (a: term):
  $ rwt a a $;

axiom rwt_sym (a b: term):
  $ rwt a b $ >
  $ rwt b a $;

axiom rwt_trans (a b c: term):
  $ rwt a b $ >
  $ rwt b c $ >
  $ rwt a c $;

axiom sbst_const {x: term} (a b: term):
  $ rwt (sbst x a b) b $;

axiom sbst_var {x: term} (a: term):
  $ rwt (sbst x a x) a $;

axiom rwt_sbst {x: term} (a b: term) (c d: term x):
  $ rwt a b $ >
  $ rwt c d $ >
  $ rwt (sbst x a c) (sbst x b d) $;

axiom sbst_sbst {x y: term} (a: term) (b: term y) (c: term x y):
  $ rwt (sbst y a (sbst x b c)) (sbst x (sbst y a b) (sbst y a c)) $;

theorem sbst_reduce {x y: term} (a: term) (b: term x):
  $ rwt (sbst y a (sbst x y b)) (sbst x a b) $ =
  '(rwt_trans sbst_sbst (rwt_sbst sbst_var sbst_const));

term sbstx {x: term} (a: term) (G: ctx x): ctx;
term rwtc: ctx > ctx > jdmt;

axiom rwtc_refl (A: ctx):
  $ rwtc A A $;

axiom rwtc_sym (A B: ctx):
  $ rwtc A B $ >
  $ rwtc B A $;

axiom rwtc_trans (A B C: ctx):
  $ rwtc A B $ >
  $ rwtc B C $ >
  $ rwtc A C $;

axiom rwtc_comma (A B C D: ctx):
  $ rwtc A B $ >
  $ rwtc C D $ >
  $ rwtc (A, C) (B, D) $;

theorem rwtc_comma_l (A B C: ctx)
  (h: $ rwtc A B $):
  $ rwtc (A, C) (B, C) $ =
  '(rwtc_comma h rwtc_refl);

theorem rwtc_comma_r (A B C: ctx)
  (h: $ rwtc B C $):
  $ rwtc (A, B) (A, C) $ =
  '(rwtc_comma rwtc_refl h);

axiom ctx_assoc (G D E: ctx):
  $ rwtc (G, (D, E)) (G, D, E) $;

theorem ctx_assoc_inv (G D E: ctx):
  $ rwtc (G, D, E) (G, (D, E)) $ =
  '(rwtc_sym ctx_assoc);

axiom ctx_lunit (G: ctx):
  $ rwtc (zctx, G) G $;

theorem ctx_lunit_inv (G: ctx):
  $ rwtc G (zctx, G) $ =
  '(rwtc_sym ctx_lunit);

axiom ctx_runit (G: ctx):
  $ rwtc (G, zctx) G $;

theorem ctx_runit_inv (G: ctx):
  $ rwtc G (G, zctx) $ =
  '(rwtc_sym ctx_runit);

axiom rwtc_ty {x: term} (A B: term):
  $ rwt A B $ >
  $ rwtc (x: A) (x: B) $;

axiom sbstx_const {x: term} (a: term) (G: ctx):
  $ rwtc (sbstx x a G) G $;

axiom rwtc_sbstx {x: term} (a b: term) (c d: ctx x):
  $ rwt a b $ >
  $ rwtc c d $ >
  $ rwtc (sbstx x a c) (sbstx x b d) $;

axiom sbstx_sbstx {x y: term} (a: term) (b: term y) (c: ctx x y):
  $ rwtc (sbstx y a (sbstx x b c)) (sbstx x (sbst y a b) (sbstx y a c)) $;

theorem sbstx_reduce {x y: term} (a: term) (b: ctx x):
  $ rwtc (sbstx y a (sbstx x y b)) (sbstx x a b) $ =
  '(rwtc_trans sbstx_sbstx (rwtc_sbstx sbst_var sbstx_const));

axiom sbstx_comma {x: term} (a: term) (G D: ctx x):
  $ rwtc (sbstx x a (G, D)) ((sbstx x a G), (sbstx x a D)) $;

axiom sbstx_typed {x y: term} (a: term) (B: term x):
  $ rwtc (sbstx x a (y: B)) (y: (sbst x a B)) $;

axiom rewrite_ctx (G D: ctx) (c: consequent):
  $ rwtc G D $ >
  $ G |- c $ >
  $ D |- c $;

axiom rewrite_term (G: ctx) (a b A: term):
  $ rwt a b $ >
  $ G |- a: A $ >
  $ G |- b: A $;

axiom rewrite_eq (G: ctx) (a b c d A: term):
  $ rwt a c $ >
  $ rwt b d $ >
  $ G |- a = b: A $ >
  $ G |- c = d: A $;

axiom rewrite_type (A B: term) (G: ctx) (a: term_or_eq):
  $ rwt A B $ >
  $ G |- a: A $ >
  $ G |- a: B $;

axiom ctx_ext (G: ctx) {x: term} (A: term) (l: lvl):
  $ G |- A: U l $ >
  $ ctx G, x: A $;

axiom vble (G: ctx) {x: term} (A: term) (D: ctx x):
  $ ctx G, x: A, D $ >
  $ G, x: A, D |- x: A $;

theorem vble_rightmost (G: ctx) {x: term} (A: term)
  (h: $ ctx G, x: A $):
  $ G, x: A |- x: A $ =
  '(rewrite_ctx ctx_runit (vble (rewrite_ctx ctx_runit_inv h)));

theorem sbstx_ty_var {x y: term} (A: term) (G: ctx x) (D: ctx x y) (c: consequent x y)
  (h: $ G, y: (sbst x A x), D |- c $):
  $ G, y: A, D |- c $ =
  '(rewrite_ctx
    (rwtc_comma
      (rwtc_comma_r (rwtc_ty sbst_var))
      rwtc_refl)
    h);

axiom sbst_1 (G: ctx) {x: term} (a A: term) (D: ctx x) (b B: term x):
  $ G |- a: A $ >
  $ G, x: A, D |- b: B $ >
  $ G, (sbstx x a D) |- (sbst x a b): (sbst x a B) $;

theorem sbst_1_rightmost (G: ctx) {x: term} (a A: term) (b B: term x)
  (h1: $ G |- a: A $)
  (h2: $ G, x: A |- b: B $):
  $ G |- (sbst x a b): (sbst x a B) $ =
  '(rewrite_ctx ctx_runit (rewrite_ctx (rwtc_comma_r sbstx_const) (sbst_1 h1 (rewrite_ctx (rwtc_sym ctx_runit) h2))));

axiom sbst_2 (G: ctx) {x: term} (a A: term) (D: ctx x) (b c B: term x):
  $ G |- a: A $ >
  $ G, x: A, D |- b = c: B $ >
  $ G, (sbstx x a D) |- (sbst x a b): (sbst x a B) $;

axiom sbst_3 (G: ctx) {x: term} (a b A: term) (D: ctx x) (c C: term x):
  $ G |- a = b: A $ >
  $ G, x: A, D |- b = c: C $ >
  $ G, (sbstx x a D) |- (sbst x a c) = (sbst x b c): (sbst x a C) $;

axiom weakening (G D: ctx) {x: term} (A B: term) (l: lvl) (b: term_or_eq):
  $ G |- A: U l $ >
  $ G, D |- b: B $ >
  $ G, x: A, D |- b: B $;

theorem weakening_rightmost (G: ctx) {x: term} (A B: term) (l: lvl) (b: term_or_eq)
  (h1: $ G |- A: U l $)
  (h2: $ G |- b: B $):
  $ G, x: A |- b: B $ =
  '(rewrite_ctx ctx_runit (weakening h1 (rewrite_ctx ctx_runit_inv h2)));

axiom eq_refl (G: ctx) (a A: term):
  $ G |- a: A $ >
  $ G |- a = a: A $;

axiom eq_sym (G: ctx) (a b A: term):
  $ G |- a = b: A $ >
  $ G |- b = a: A $;

axiom eq_trans (G: ctx) (a b c A: term):
  $ G |- a = b: A $ >
  $ G |- b = c: A $ >
  $ G |- a = c: A $;

axiom eq_ty (G: ctx) (a: term_or_eq) (A B: term) (l: lvl):
  $ G |- a: A $ >
  $ G |- A = B: U l $ >
  $ G |- a: B $;

-- axiom eq_pr_1 (G: ctx) (a b A: term):
--   $ G |- a = b: A $ >
--   $ G |- a: A $;

-- theorem eq_pr_2 (G: ctx) (a b A: term)
--   (h: $ G |- a = b: A $):
--   $ G |- b: A $ =
--   '(eq_pr_1 (eq_sym h));

axiom U_intro (G: ctx) (l: lvl):
  $ ctx G $ > $ G |- U l: U (ls l) $;

axiom U_cumul (G: ctx) (A: term_or_eq) (l: lvl):
  $ G |- A: U l $ > $ G |- A: U (ls l) $;

-- --| Extract type from typing judgment, with universe level as an unknown variable.
-- --|
-- --| Relies upon that any type introduction implies type is formed.
-- axiom type_of {l: lvl} (a A: wff):
--     $ a: A => A: U l $;

term Pi {x: term} (A: term) (B: term x): term;

axiom rwt_Pi {x: term} (A C: term) (B D: term x):
  $ rwt A C $ >
  $ rwt B D $ >
  $ rwt (Pi x A B) (Pi x C D) $;

axiom sbst_Pi {x y: term} (a: term) (B: term x) (C: term x y):
  $ rwt (sbst x a (Pi y B C)) (Pi y (sbst x a B) (sbst x a C)) $;

axiom alpha_Pi {x y: term} (A: term) (B: term x):
  $ rwt (Pi x A B) (Pi y A (sbst x y B)) $;

axiom Pi_form (G: ctx) {x: term} (A: term) (B: term x) (l: lvl):
  $ G |- A: U l $ >
  $ G, x: A |- B: U l $ >
  $ G |- Pi x A B: U l $;

axiom Pi_form_cong (G: ctx) {x: term} (A0 A1: term) (B0 B1: term x) (l: lvl):
  $ G |- A0 = A1: U l $ >
  $ G, x: A0 |- B0 = B1: U l $ >
  $ G |- Pi x A0 B0 = Pi x A1 B1: U l $;

term lam {x: term} (A: term) (b: term x): term;

axiom rwt_lam {x: term} (A C: term) (b d: term x):
  $ rwt A C $ >
  $ rwt b d $ >
  $ rwt (lam x A b) (lam x C d) $;

axiom sbst_lam {x y: term} (a: term) (B: term x) (c: term x y):
  $ rwt (sbst x a (lam y B c)) (lam y (sbst x a B) (sbst x a c)) $;

axiom alpha_lam {x y: term} (A: term) (b: term x):
  $ rwt (lam x A b) (lam y A (sbst x y b)) $;

axiom Pi_intro (G: ctx) {x: term} (A: term) (b B: term x):
  $ G, x: A |- b: B $ >
  $ G |- lam x A b: Pi x A B $;

axiom Pi_intro_cong (G: ctx) {x: term} (A0 A1: term) (b0 b1 B: term x) (l: lvl):
  $ G |- A0 = A1: U l $ >
  $ G, x: A0 |- b0 = b1: B $ >
  $ G |- lam x A0 b0 = lam x A1 b1: Pi x A0 B $;

term ap (a b: term): term;

axiom rwt_ap (a b c d: term):
  $ rwt a c $ >
  $ rwt b d $ >
  $ rwt (ap a b) (ap c d) $;

axiom sbst_ap {x: term} (a: term) (b c: term x):
  $ rwt (sbst x a (ap b c)) (ap (sbst x a b) (sbst x a c)) $;

axiom Pi_elim (G: ctx) {x: term} (a A f: term) (B: term x):
  $ G |- f: Pi x A B $ >
  $ G |- a: A $ >
  $ G |- ap f a: sbst x a B $;

axiom Pi_elim_cong (G: ctx) {x: term} (a0 a1 A f0 f1: term) (B: term x):
  $ G |- f0 = f1: Pi x A B $ >
  $ G |- a0 = a1: A $ >
  $ G |- ap f0 a0 = ap f1 a1: sbst x a0 B $;

axiom Pi_comp (G: ctx) {x: term} (a A: term) (b B: term x):
  $ G, x: A |- b: B $ >
  $ G |- a: A $ >
  $ G |- ap (lam x A b) a = sbst x a b: sbst x a B $;

theorem Pi_comp_pr_1 (G: ctx) {x: term} (a A: term) (b B: term x) {.y: term}
  (h1: $ G, x: A |- b: B $)
  (h2: $ G |- a: A $):
  $ G |- ap (lam x A b) a: sbst x a B $ =
  '(rewrite_type sbst_reduce (Pi_elim (rewrite_type (! alpha_Pi _ y) (Pi_intro h1)) h2));

theorem Pi_comp_pr_2 (G: ctx) {x: term} (a A: term) (b B: term x)
  (h1: $ G, x: A |- b: B $)
  (h2: $ G |- a: A $):
  $ G |- sbst x a b: sbst x a B $ =
  '(sbst_1_rightmost h2 h1);

axiom Pi_uniq (G: ctx) {x: term} (A f: term) (B: term x):
  $ G |- f: Pi x A B $ >
  $ G |- f = lam x A (ap f x): Pi x A B $;

theorem Pi_uniq_pr_2 (G: ctx) {x: term} (A f: term) (B: term x) (l: lvl) {.y: term}
  (h1: $ G |- A: U l $)
  (h2: $ G |- f: Pi x A B $):
  $ G |- lam x A (ap f x): Pi x A B $ =
  '(rewrite_type (rwt_sym alpha_Pi) @ rewrite_term (rwt_sym alpha_lam) @ Pi_intro
    (rewrite_term (rwt_sym @ rwt_trans sbst_ap (rwt_ap sbst_const sbst_var)) @ Pi_elim
      (weakening_rightmost h1 h2)
      (vble_rightmost (! ctx_ext _ y _ _ h1))));

def fun (A B: term) {.x: term}: term = $ Pi x A B $;
infixr fun: $->$ prec 30;

theorem fun_form (G: ctx) (A B: term) (l: lvl) {.x: term}
  (ha: $ G |- A: U l $)
  (hb: $ G |- B: U l $):
  $ G |- A -> B: U l $ =
  '(Pi_form ha (! weakening_rightmost _ x _ _ _ _ ha hb));

theorem fun_form_cong (G: ctx) (A0 A1 B0 B1: term) (l: lvl) {.x: term}
  (ha: $ G |- A0: U l $)
  (hab: $ G |- A0 = A1: U l $)
  (hc: $ G |- B0 = B1: U l $):
  $ G |- A0 -> B0 = A1 -> B1: U l $ =
  '(Pi_form_cong hab (! weakening_rightmost _ x _ _ _ _ ha hc));

theorem fun_intro (G: ctx) {x: term} (A B: term) (b: term x)
  (h: $ G, x: A |- b: B $):
  $ G |- lam x A b: A -> B $ =
  '(Pi_intro h);

theorem fun_intro_cong (G: ctx) {x: term} (A0 A1 B: term) (b0 b1: term x) (l: lvl)
  (ha: $ G |- A0 = A1: U l $)
  (hb: $ G, x: A0 |- b0 = b1: B $):
  $ G |- lam x A0 b0 = lam x A1 b1: A0 -> B $ =
  '(Pi_intro_cong ha hb);

theorem fun_elim (G: ctx) (a A f B: term) {.x: term}
  (hf: $ G |- f: A -> B $)
  (ha: $ G |- a: A $):
  $ G |- ap f a: B $ =
  '(rewrite_type sbst_const (! Pi_elim _ x _ _ _ _ hf ha));

theorem fun_elim_cong (G: ctx) (a0 a1 A f0 f1 B: term) {.x: term}
  (hf: $ G |- f0 = f1: A -> B $)
  (ha: $ G |- a0 = a1: A $):
  $ G |- ap f0 a0 = ap f1 a1: B $ =
  '(rewrite_type sbst_const (! Pi_elim_cong _ x _ _ _ _ _ _ hf ha));

theorem fun_comp (G: ctx) {x: term} (a A B: term) (b: term x)
  (h1: $ G, x: A |- b: B $)
  (h2: $ G |- a: A $):
  $ G |- ap (lam x A b) a = sbst x a b: B $ =
  '(rewrite_type sbst_const (Pi_comp h1 h2));

theorem fun_uniq (G: ctx) {x: term} (A f B: term)
  (h: $ G |- f: A -> B $):
  $ G |- f = lam x A (ap f x): A -> B $ =
  '(Pi_uniq h);

term Sigma {x: term} (A: term) (B: term x): term;

axiom rwt_Sigma {x: term} (A C: term) (B D: term x):
  $ rwt A C $ >
  $ rwt B D $ >
  $ rwt (Sigma x A B) (Sigma x C D) $;

axiom sbst_Sigma {x y: term} (a: term) (B: term x) (C: term x y):
  $ rwt (sbst x a (Sigma y B C)) (Sigma y (sbst x a B) (sbst x a C)) $;

axiom alpha_Sigma {x y: term} (A: term) (B: term x):
  $ rwt (Sigma x A B) (Sigma y A (sbst x y B)) $;

axiom Sigma_form (G: ctx) {x: term} (A: term) (B: term x) (l: lvl):
  $ G |- A: U l $ >
  $ G, x: A |- B: U l $ >
  $ G |- Sigma x A B: U l $;

axiom Sigma_form_cong (G: ctx) {x: term} (A0 A1: term) (B0 B1: term x) (l: lvl):
  $ G |- A0 = A1: U l $ >
  $ G, x: A0 |- B0 = B1: U l $ >
  $ G |- Sigma x A0 B0 = Sigma x A1 B1: U l $;

term pair (a b: term): term;

axiom rwt_pair (a0 b0 a1 b1: term):
  $ rwt a0 a1 $ >
  $ rwt b0 b1 $ >
  $ rwt (pair a0 b0) (pair a1 b1) $;

axiom sbst_pair {x: term} (a: term) (b c: term x):
  $ rwt (sbst x a (pair b c)) (pair (sbst x a b) (sbst x a c)) $;

axiom Sigma_intro (G: ctx) {x: term} (A a b: term) (B: term x) (l: lvl):
  $ G, x: A |- B: U l $ >
  $ G |- a: A $ >
  $ G |- b: sbst x a B $ >
  $ G |- pair a b: Sigma x A B $;

axiom Sigma_intro_cong (G: ctx) {x: term} (A a0 a1 b0 b1: term) (B: term x) (l: lvl):
  $ G, x: A |- B: U l $ >
  $ G |- a0 = a1: A $ >
  $ G |- b0 = b1: sbst x a0 B $ >
  $ G |- pair a0 b0 = pair a1 b1: Sigma x A B $;

term ind_Sigma {x: term} (A: term) {y: term} (B: term x) {z: term} (g: term x y) (C: term z) (p: term): term;

axiom rwt_ind_Sigma {x y z: term} (A0 A1 p0 p1: term) (B0 B1: term x) (g0 g1: term x y) (C0 C1: term z):
  $ rwt A0 A1 $ >
  $ rwt B0 B1 $ >
  $ rwt g0 g1 $ >
  $ rwt C0 C1 $ >
  $ rwt p0 p1 $ >
  $ rwt (ind_Sigma x A0 y B0 z g0 C0 p0) (ind_Sigma x A1 y B1 z g1 C1 p1) $;

axiom sbst_ind_Sigma {x y z w: term} (A p d: term w) (B: term x w) (g: term x y w) (C: term z w):
  $ rwt (sbst w d (ind_Sigma x A y B z g C p)) (ind_Sigma x (sbst w d A) y (sbst w d B) z (sbst w d g) (sbst w d C) (sbst w d p)) $;

axiom alpha_ind_Sigma_x {x0 x1 y z: term} (A p: term) (B: term x0) (g: term x0 y) (C: term z):
  $ rwt (ind_Sigma x0 A y B z g C p) (ind_Sigma x1 A y (sbst x0 x1 B) z (sbst x0 x1 g) C p) $;

axiom alpha_ind_Sigma_y {x y0 y1 z: term} (A p: term) (B: term x) (g: term x y0) (C: term z):
  $ rwt (ind_Sigma x A y0 B z g C p) (ind_Sigma x A y1 B z (sbst y0 y1 g) C p) $;

axiom alpha_ind_Sigma_z {x y z0 z1: term} (A p: term) (B: term x) (g: term x y) (C: term z0):
  $ rwt (ind_Sigma x A y B z0 g C p) (ind_Sigma x A y B z1 g (sbst z0 z1 C) p) $;

axiom Sigma_elim (G: ctx) {x y z: term} (A p: term) (B: term x) (g: term x y) (C: term z) (l: lvl):
  $ G, z: Sigma x A B |- C: U l $ >
  $ G, x: A, y: B |- g: sbst z (pair x y) C $ >
  $ G |- p: Sigma x A B $ >
  $ G |- ind_Sigma x A y B z g C p: sbst z p C $;

axiom Sigma_elim_cong (G: ctx) {x y z: term} (A0 A1 p0 p1: term) (B0 B1: term x) (g0 g1: term x y) (C0 C1: term z) (l: lvl):
  $ G |- A0 = A1: U l $ >
  $ G, x: A0 |- B0 = B1: U l $ >
  $ G, z: Sigma x A0 B0 |- C0 = C1: U l $ >
  $ G, x: A0, y: B0 |- g0 = g1: sbst z (pair x y) C0 $ >
  $ G |- p0 = p1: Sigma x A0 B0 $ >
  $ G |- ind_Sigma x A0 y B0 z g0 C0 p0 = ind_Sigma x A1 y B1 z g1 C1 p1: sbst z p0 C0 $;

axiom Sigma_comp (G: ctx) {x y z: term} (A a b: term) (B: term x) (g: term x y) (C: term z) (l: lvl):
  $ G, z: Sigma x A B |- C: U l $ >
  $ G, x: A, y: B |- g: sbst z (pair x y) C $ >
  $ G |- a: A $ >
  $ G |- b: sbst x a B $ >
  $ G |- ind_Sigma x A y B z g C (pair a b) = sbst x a (sbst y b g): sbst z (pair a b) C $;

theorem Sigma_elim_1 (G: ctx) {x y z p: term} (A: term) (B: term x) (g: term x y) (C: term z) (l: lvl) {.w: term}
  (hA: $ G |- A: U l $)
  (hS: $ G |- Sigma x A B: U l $)
  (hC: $ G, z: Sigma x A B |- C: U l $)
  (hg: $ G, x: A, y: B |- g: sbst z (pair x y) C $):
  $ G, p: Sigma x A B |- ind_Sigma x A y B z g C p: sbst z p C $ =
  '(rewrite_term (rwt_sym alpha_ind_Sigma_x) @ Sigma_elim (rewrite_ctx (rwtc_comma_r @ rwtc_ty alpha_Sigma) @ weakening hS hC) (rewrite_ctx (rwtc_comma_r @ sbstx_typed) @ rewrite_ctx ctx_assoc @ weakening hS @ rewrite_ctx ctx_assoc_inv @ rewrite_type (rwt_trans sbst_sbst @ rwt_sbst (rwt_trans sbst_pair @ rwt_pair sbst_var sbst_const) sbst_const) @ sbst_1 (vble_rightmost @ ctx_ext hA) @ rewrite_ctx ctx_assoc @ weakening hA @ rewrite_ctx ctx_assoc_inv hg) @ rewrite_type (! alpha_Sigma _ w) @ vble_rightmost @ ctx_ext hS);

theorem Sigma_elim_2 (G: ctx) {x y z p: term} (A: term) (B: term x) (g: term x) (C: term z) (l: lvl) {.w .v: term}
  (hA: $ G |- A: U l $)
  (hB: $ G, x: A |- B: U l $)
  (hS: $ G |- Sigma x A B: U l $)
  (hC: $ G, z: Sigma x A B |- C: U l $)
  (hg: $ G, x: A |- g: Pi y B (sbst z (pair x y) C) $):
  $ G, p: Sigma x A B |- ind_Sigma x A y B z (ap g y) C p: sbst z p C $ =
  '(Sigma_elim_1 hA hS hC @ rewrite_type (rwt_trans sbst_sbst @ rwt_sbst (rwt_trans sbst_pair @ rwt_pair sbst_const sbst_var) sbst_const) @ Pi_elim (rewrite_type (rwt_sym @ rwt_trans alpha_Pi @ rwt_Pi rwt_refl @ rwt_trans sbst_sbst @ rwt_sbst (rwt_trans sbst_pair @ rwt_pair sbst_const sbst_var) @ ! sbst_const w) @ weakening_rightmost hB @ rewrite_type (rwt_trans alpha_Pi @ ! rwt_Pi v _ _ _ _ rwt_refl @ rwt_trans sbst_sbst @ rwt_sbst (rwt_trans sbst_pair @ rwt_pair sbst_const sbst_var) sbst_const) hg) @ vble_rightmost @ ctx_ext hB);
