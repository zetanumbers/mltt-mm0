--     $ b[a / x] => b $;

-- axiom subst_const_eq {x: wff} (a b A: wff):
--     $ eq_intro (b[a / x]) b A $;

-- axiom subst_var {x: wff} (a: wff):
--     $ x[a / x] <=> a $;

-- axiom subst_var_eq {x: wff} (a A: wff):
--     $ eq_intro (x[a / x]) a A $;

-- axiom subst_sym {x y: wff} (a b: wff) (c: wff x):
--     $ c[a / x][b / y] => c[b / y][a / x] $;

-- axiom subst_cong_1 {x: wff} (a c T: wff) (b: wff x):
--     $ b[(a = c) / x]: T <=> b[a / x] = b[c / x]: T $;
-- axiom subst_cong_2 {x: wff} (a T: wff) (b c: wff x):
--     $ (b = c)[a / x]: T <=> b[a / x] = c[a / x]: T $;

-- theorem subst_cong_diag {x: wff} (a c T: wff) (b d: wff x):
--     $ (b = d)[(a = c) / x]: T => b[a / x] = d[c / x]: T $ =
--     (lamp '(s) '(eq_trans
--         (conj_elim_1 subst_cong_1 @ conj_elim_1 @ eq_pr @ conj_elim_1 subst_cong_2 s)
