delimiter $ ( $ $ , ) : $;

sort term;
provable strict sort jdmt;
strict sort ctx;

strict sort term_or_eq;
term term_not_eq: term > term_or_eq;
coercion term_not_eq: term > term_or_eq;
term eq_not_term: term > term > term_or_eq;
infixl eq_not_term: $=$ prec 25;

strict sort typed_expr;
term typed: term_or_eq > term > typed_expr;
infixl typed: $:$ prec 20;

strict sort consequent;
term typed_consequent: typed_expr > consequent;
coercion typed_consequent: typed_expr > consequent;

term sequent: ctx > consequent > jdmt;
infixr sequent: $|-$ prec 10;

term ctx_consequent: consequent;
def is_ctx (G: ctx): jdmt = $ G |- ctx_consequent $;
prefix is_ctx: $ctx$ prec 10;

term zctx: ctx;
axiom ctx_emp: $ is_ctx zctx $;

term pctx: ctx > ctx > ctx;
infixl pctx: $,$ prec 15;

axiom ctx_lassoc (G D E: ctx) (c: consequent):
  $ G, (D, E) |- c $ >
  $ G, D, E |- c $;

axiom ctx_rassoc (G D E: ctx) (c: consequent):
  $ G, D, E |- c $ >
  $ G, (D, E) |- c $;

axiom ctx_lunit (G: ctx) (c: consequent):
  $ zctx, G |- c $ >
  $ G |- c $;

axiom ctx_runit (G: ctx) (c: consequent):
  $ G, zctx |- c $ >
  $ G |- c $;

axiom ctx_lunit_inv (G: ctx) (c: consequent):
  $ G |- c $ >
  $ zctx, G |- c $;

axiom ctx_runit_inv (G: ctx) (c: consequent):
  $ G |- c $ >
  $ G, zctx |- c $;

term ty_ctx: typed_expr > ctx;
coercion ty_ctx: typed_expr > ctx;

sort lvl;
term lz: lvl;
term ls: lvl > lvl;

term U: lvl > term;

axiom ctx_ext (G: ctx) {x: term} (A: term) (l: lvl):
  $ G |- A: U l $ >
  $ ctx G, x: A $;

axiom vble (G: ctx) {x: term} (A: term) (D: ctx x):
  $ ctx G, x: A, D $ >
  $ G, x: A, D |- x: A $;

theorem vble_rightmost (G: ctx) {x: term} (A: term)
  (h: $ ctx G, x: A $):
  $ G, x: A |- x: A $ =
  '(ctx_runit (vble (ctx_runit_inv h)));

term subst {x: term} (a: term) (b: term x): term;
term subst_ctx {x: term} (a: term) (G: ctx x): ctx;

term rewrites: term > term > jdmt;

axiom rewrites_refl (a: term):
  $ rewrites a a $;

axiom rewrites_trans (a b c: term):
  $ rewrites a b $ >
  $ rewrites b c $ >
  $ rewrites a c $;

axiom subst_const {x: term} (a b: term):
  $ rewrites (subst x a b) b $; 

axiom subst_var {x: term} (a: term):
  $ rewrites (subst x a x) a $; 

-- axiom subst_nop {x: term} (a: term x):
--   $ rewrites (subst x x a) a $;

term rewrites_ctx: ctx > ctx > jdmt;

axiom rewrites_ctx_refl (A: ctx):
  $ rewrites_ctx A A $;

axiom rewrites_ctx_trans (A B C: ctx):
  $ rewrites_ctx A B $ >
  $ rewrites_ctx B C $ >
  $ rewrites_ctx A C $;

axiom rewrites_pctx (A B C D: ctx):
  $ rewrites_ctx A B $ >
  $ rewrites_ctx C D $ >
  $ rewrites_ctx (A, C) (B, D) $;

theorem rewrites_pctx_l (A B C: ctx)
  (h: $ rewrites_ctx A B $):
  $ rewrites_ctx (A, C) (B, C) $ =
  '(rewrites_pctx h rewrites_ctx_refl);

theorem rewrites_pctx_r (A B C: ctx)
  (h: $ rewrites_ctx B C $):
  $ rewrites_ctx (A, B) (A, C) $ =
  '(rewrites_pctx rewrites_ctx_refl h);

axiom rewrites_ctx_ty {x: term} (A B: term):
  $ rewrites A B $ >
  $ rewrites_ctx (x: A) (x: B) $;

axiom subst_ctx_const {x: term} (a: term) (G: ctx):
  $ rewrites_ctx (subst_ctx x a G) G $; 

-- axiom subst_ctx_nop {x: term} (G: ctx):
--   $ rewrites_ctx (subst_ctx x x G) G $;

axiom subst_ctx_pctx {x: term} (a: term) (G D: ctx x):
  $ rewrites_ctx (subst_ctx x a (G, D)) ((subst_ctx x a G), (subst_ctx x a D)) $; 

axiom rewrite_ctx (G D: ctx) (c: consequent):
  $ rewrites_ctx G D $ >
  $ G |- c $ >
  $ D |- c $;

axiom rewrite_term (G: ctx) (a b A: term):
  $ rewrites a b $ >
  $ G |- a: A $ >
  $ G |- b: A $;

axiom rewrite_eq (G: ctx) (a b c d A: term):
  $ rewrites a c $ >
  $ rewrites b d $ >
  $ G |- a = b: A $ >
  $ G |- c = d: A $;

axiom rewrite_type (A B: term) (G: ctx) (a: term_or_eq):
  $ rewrites A B $ >
  $ G |- a: A $ >
  $ G |- a: B $;

theorem subst_ctx_ty_var {x y: term} (A: term) (G: ctx x) (D: ctx x y) (c: consequent x y)
  (h: $ G, y: (subst x A x), D |- c $):
  $ G, y: A, D |- c $ =
  '(rewrite_ctx
    (rewrites_pctx
      (rewrites_pctx_r (rewrites_ctx_ty subst_var))
      rewrites_ctx_refl)
    h);

axiom subst_1 (G: ctx) {x: term} (a A: term) (D: ctx x) (b B: term x):
  $ G |- a: A $ >
  $ G, x: A, D |- b: B $ >
  $ G, (subst_ctx x a D) |- (subst x a b): (subst x a B) $;

theorem subst_1_rightmost (G: ctx) {x: term} (a A: term) (b B: term x)
  (h1: $ G |- a: A $)
  (h2: $ G, x: A |- b: B $):
  $ G |- (subst x a b): (subst x a B) $ =
  '(ctx_runit (rewrite_ctx (rewrites_pctx_r subst_ctx_const) (subst_1 h1 (ctx_runit_inv h2))));

axiom subst_2 (G: ctx) {x: term} (a A: term) (D: ctx x) (b c B: term x):
  $ G |- a: A $ >
  $ G, x: A, D |- b = c: B $ >
  $ G, (subst_ctx x a D) |- (subst x a b): (subst x a B) $;

axiom subst_3 (G: ctx) {x: term} (a b A: term) (D: ctx x) (c C: term x):
  $ G |- a = b: A $ >
  $ G, x: A, D |- b = c: C $ >
  $ G, (subst_ctx x a D) |- (subst x a c) = (subst x b c): (subst x a C) $;

axiom weakening (G D: ctx) {x: term} (A: term) (l: lvl) (b: term_or_eq) (B: term):
  $ G |- A: U l $ >
  $ G, D |- b: B $ >
  $ G, x: A, D |- b: B $;

axiom eq_refl (G: ctx) (a A: term):
  $ G |- a: A $ >
  $ G |- a = a: A $;

axiom eq_sym (G: ctx) (a b A: term):
  $ G |- a = b: A $ >
  $ G |- b = a: A $;

axiom eq_trans (G: ctx) (a b c A: term):
  $ G |- a = b: A $ >
  $ G |- b = c: A $ >
  $ G |- a = c: A $;

axiom eq_ty (G: ctx) (a: term_or_eq) (A B: term) (l: lvl):
  $ G |- a: A $ >
  $ G |- A = B: U l $ >
  $ G |- a: B $;

-- axiom eq_pr_1 (G: ctx) (a b A: term):
--   $ G |- a = b: A $ >
--   $ G |- a: A $;

-- theorem eq_pr_2 (G: ctx) (a b A: term)
--   (h: $ G |- a = b: A $):
--   $ G |- b: A $ =
--   '(eq_pr_1 (eq_sym h));

axiom U_intro (G: ctx) (l: lvl):
  $ ctx G $ > $ G |- U l: U (ls l) $;

axiom U_cumul (G: ctx) (A: term_or_eq) (l: lvl):
  $ G |- A: U l $ > $ G |- A: U (ls l) $;

-- --| Extract type from typing judgment, with universe level as an unknown variable.
-- --|
-- --| Relies upon that any type introduction implies type is formed.
-- axiom type_of {l: lvl} (a A: wff):
--     $ a: A => A: U l $;

term Pi {x: term} (A: term) (B: term x): term;

axiom rewrites_Pi {x y: term} (a: term) (B C: term x):
  $ rewrites (subst x a (Pi y B C)) (Pi y (subst x a B) (subst x a C)) $;

-- axiom rewrites_Pi_bound {x: term} (a: term) (B C: term x):
--   $ rewrites (subst x a (Pi x B C)) (Pi x B C) $;

axiom Pi_form (G: ctx) {x: term} (A: term) (B: term x) (l: lvl):
  $ G |- A: U l $ >
  $ G, x: A |- B: U l $ >
  $ G |- Pi x A B: U l $;

axiom Pi_form_cong_1 (G: ctx) {x: term} (A B: term) (C: term x) (l: lvl):
  $ G |- A = B: U l $ >
  $ G, x: A |- C: U l $ >
  $ G |- Pi x A C = Pi x B C: U l $;

axiom Pi_form_cong_2 (G: ctx) {x: term} (A: term) (B C: term x) (l: lvl):
  $ G |- A: U l $ >
  $ G, x: A |- B = C: U l $ >
  $ G |- Pi x A B = Pi x A C: U l $;

term lam {x: term} (A: term) (b: term x): term;

axiom rewrites_lam {x y: term} (a: term) (B c: term x):
  $ rewrites (subst x a (lam y B c)) (lam y (subst x a B) (subst x a c)) $;

-- axiom rewrites_lam_bound {x: term} (a: term) (B c: term x):
--   $ rewrites (subst x a (lam x B c)) (lam x B c) $;

axiom Pi_intro (G: ctx) {x: term} (A: term) (b B: term x):
  $ G, x: A |- b: B $ >
  $ G |- lam x A b: Pi x A B $;

axiom Pi_intro_cong_1 (G: ctx) {x: term} (A B: term) (c C: term x) (l: lvl):
  $ G |- A = B: U l $ >
  $ G, x: A |- c: C $ >
  $ G |- lam x A c = lam x B c: Pi x A C $;

axiom Pi_intro_cong_2 (G: ctx) {x: term} (A: term) (b c B: term x):
  $ G, x: A |- b = c: B $ >
  $ G |- lam x A b = lam x A c: Pi x A B $;

term ap (a b: term): term;

axiom rewrites_ap {x: term} (a: term) (b c: term x):
  $ rewrites (subst x a (ap b c)) (ap (subst x a b) (subst x a c)) $;

axiom Pi_elim (G: ctx) {x: term} (a A: term) (f B: term x):
  $ G |- f: Pi x A B $ >
  $ G |- a: A $ >
  $ G |- ap f a: subst x a B $;

axiom Pi_elim_cong_1 (G: ctx) {x: term} (a A: term) (f g B: term x):
  $ G |- f = g: Pi x A B $ >
  $ G |- a: A $ >
  $ G |- ap f a = ap g a: subst x a B $;

axiom Pi_elim_cong_2 (G: ctx) {x: term} (a b A: term) (f C: term x):
  $ G |- f: Pi x A C $ >
  $ G |- a = b: A $ >
  $ G |- ap f a = ap f b: subst x a C $;

axiom Pi_comp (G: ctx) {x: term} (a A: term) (b B: term x):
  $ G, x: A |- b: B $ >
  $ G |- a: A $ >
  $ G |- ap (lam x A b) a = subst x a b: subst x a B $;

theorem Pi_comp_pr_1 (G: ctx) {x: term} (a A: term) (b B: term x)
  (h1: $ G, x: A |- b: B $)
  (h2: $ G |- a: A $):
  $ G |- ap (lam x A b) a: subst x a B $ =
  '(Pi_elim (Pi_intro h1) h2);

theorem Pi_comp_pr_2 (G: ctx) {x: term} (a A: term) (b B: term x)
  (h1: $ G, x: A |- b: B $)
  (h2: $ G |- a: A $):
  $ G |- subst x a b: subst x a B $ =
  '(subst_1_rightmost h2 h1);

axiom Pi_uniq (G: ctx) {x: term} (A: term) (f B: term x):
  $ G |- f: Pi x A B $ >
  $ G |- f = lam x A (ap f x): Pi x A B $;

-- theorem Pi_uniq_pr_2 (G: ctx) {x: term} (A: term) (f B: term x) (l: lvl)
--   (h1: $ G |- A: U l $)
--   (h2: $ G |- f: Pi x A B $):
--   $ G |- lam x A (ap f x): Pi x A B $ =
--   '(Pi_intro (rewrite_type subst_nop (Pi_elim (ctx_runit (weakening h1 (ctx_runit_inv h2))) (vble_rightmost (ctx_ext h1)))));
