delimiter $ ( $ $ , ) : $;

sort term;
provable strict sort jdmt;
strict sort ctx;

strict sort term_or_eq;
term term_not_eq: term > term_or_eq;
coercion term_not_eq: term > term_or_eq;
term eq_not_term: term > term > term_or_eq;
infixl eq_not_term: $=$ prec 25;

strict sort typed_expr;
term typed: term_or_eq > term > typed_expr;
infixl typed: $:$ prec 20;

strict sort consequent;
term typed_consequent: typed_expr > consequent;
coercion typed_consequent: typed_expr > consequent;

term sequent: ctx > consequent > jdmt;
infixr sequent: $|-$ prec 10;
term ctx_consequent: consequent;
def is_ctx (G: ctx): jdmt = $ G |- ctx_consequent $;
prefix is_ctx: $ctx$ prec 10;

term zctx: ctx;
axiom ctx_emp: $ is_ctx zctx $;

term pctx: ctx > ctx > ctx;
infixl pctx: $,$ prec 15;

axiom ctx_lassoc (G D E: ctx) (c: consequent): $ G, (D, E) |- c $ > $ G, D, E |- c $;
axiom ctx_rassoc (G D E: ctx) (c: consequent): $ G, D, E |- c $ > $ G, (D, E) |- c $;
axiom ctx_lunit (G: ctx) (c: consequent): $ zctx, G |- c $ > $ G |- c $;
axiom ctx_runit (G: ctx) (c: consequent): $ G, zctx |- c $ > $ G |- c $;

term ty_ctx: typed_expr > ctx;
coercion ty_ctx: typed_expr > ctx;

sort lvl;
term lz: lvl;
term ls: lvl > lvl;

term U: lvl > term;
-- axiom U_intro (l: lvl): $ U l: U (ls l) $;
-- axiom U_cumul (A: wff) (l: lvl): $ A: U l => A: U (ls l) $;

axiom ctx_ext (G: ctx) {x: term} (A: term) (l: lvl):
  $ G |- A: U l $ > $ ctx G, x: A $;

axiom vble {x: term} (A: term) (G D: ctx x):
  $ ctx G, x: A, D $ > $ G, x: A, D |- x: A $;

term subst {x: term} (a: term) (b: term x): term;
term subst_ctx {x: term} (a: term) (G: ctx x): ctx;

term rewrites: term > term > jdmt;
axiom rewrites_refl (a: term):
  $ rewrites a a $;
axiom rewrites_trans (a b c: term):
  $ rewrites a b $ >
  $ rewrites b c $ >
  $ rewrites a c $;

axiom subst_const {x: term} (a b: term):
  $ rewrites (subst x a b) b $; 
axiom subst_var {x: term} (a: term):
  $ rewrites (subst x a x) a $; 

term rewrites_ctx: ctx > ctx > jdmt;
axiom rewrites_ctx_refl (A: ctx):
  $ rewrites_ctx A A $;
axiom rewrites_ctx_trans (A B C: ctx):
  $ rewrites_ctx A B $ >
  $ rewrites_ctx B C $ >
  $ rewrites_ctx A C $;
axiom rewrites_pctx (A B C D: ctx):
  $ rewrites_ctx A B $ >
  $ rewrites_ctx C D $ >
  $ rewrites_ctx (A, C) (B, D) $;
axiom rewrites_ctx_ty {x: term} (A B: term):
  $ rewrites A B $ >
  $ rewrites_ctx (x: A) (x: B) $;

axiom subst_ctx_const {x: term} (a: term) (G: ctx):
  $ rewrites_ctx (subst_ctx x a G) G $; 
axiom subst_ctx_pctx {x: term} (a: term) (G D: ctx x):
  $ rewrites_ctx (subst_ctx x a (G, D)) ((subst_ctx x a G), (subst_ctx x a D)) $; 

axiom rewrite_ctx (G D: ctx) (c: consequent):
  $ rewrites_ctx G D $ >
  $ G |- c $ >
  $ D |- c $;
axiom rewrite_term (G: ctx) (a b A: term):
  $ rewrites a b $ >
  $ G |- a: A $ >
  $ G |- b: A $;
axiom rewrite_eq (G: ctx) (a b c d A: term):
  $ rewrites a c $ >
  $ rewrites b d $ >
  $ G |- a = b: A $ >
  $ G |- c = d: A $;
axiom rewrite_type (A B: term) (G: ctx) (a: term_or_eq):
  $ rewrites A B $ >
  $ G |- a: A $ >
  $ G |- a: B $;

theorem subst_ctx_ty_var {x y: term} (A: term) (G D: ctx x y) (c: consequent x y)
  (h: $ G, y: (subst x A x), D |- c $):
  $ G, y: A, D |- c $ =
  '(rewrite_ctx
    (rewrites_pctx
      (rewrites_pctx rewrites_ctx_refl (rewrites_ctx_ty subst_var))
      rewrites_ctx_refl)
    h);

axiom subst_1 (G: ctx) {x: term} (a A: term) (D: ctx x) (b: term x) (B: term x):
  $ G |- a: A $ > $ G, x: A, D |- b: B $ > $ G, (subst_ctx x a D) |- (subst x a b): (subst x a B) $;
axiom subst_2 (G: ctx) {x: term} (a A: term) (D: ctx x) (b c: term x) (B: term x):
  $ G |- a: A $ > $ G, x: A, D |- b = c: B $ > $ G, (subst_ctx x a D) |- (subst x a b): (subst x a B) $;

axiom weakening (G D: ctx) {x: term} (A: term) (l: lvl) (b: term_or_eq) (B: term):
  $ G |- A: U l $ >
  $ G, D |- b: B $ >
  $ G, x: A, D |- b: B $;


-- term typing: wff > wff > wff;
-- infixl typing: $:$ prec 50;

-- term eq: wff > wff > wff;
-- infixl eq: $=$ prec 60;

-- axiom eq_refl (a A: wff):
--     $ a: A => a = a: A $;

-- axiom eq_sym (a b A: wff):
--     $ a = b: A => b = a: A $;

-- axiom eq_trans (a b c A: wff):
--     $ a = b: A => b = c: A => a = c: A $;

-- axiom eq_pr (a b A: wff):
--     $ a = b: A => a: A /\ b: A $;

-- def eq_intro (a b A: wff): wff =
--     $ a: A \/ b: A => a = b: A $;


-- --| Extract type from typing judgment, with universe level as an unknown variable.
-- --|
-- --| Relies upon that any type introduction implies type is formed.
-- axiom type_of {l: lvl} (a A: wff):
--     $ a: A => A: U l $;

-- --| If dependent type B is const for `x: A` then extract constant formula B as a type.
-- --|
-- --| Relies upon explosion principle not being valid for typing judgments.
-- axiom const_elim {x: wff} (A B: wff) (l: lvl):
--     $ (x: A => B: U l) => B: U l $;

-- axiom eq_typed (a A B: wff) (l: lvl):
--     $ a: A => A = B: U l => a: B $;

